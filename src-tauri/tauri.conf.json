{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mcsmanager-desktop",
  "version": "0.1.0",
  "identifier": "com.yumao.mcsmanager-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCSManager Desktop",
        "width": 1400,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 680,
        "useHttpsScheme": false,
        "devtools": true,
        "additionalBrowserArgs": "--disable-web-security --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,SameSiteByDefaultCookies,CookiesWithoutSameSiteMustBeSecure,ThirdPartyCookiePhaseout,TrackingProtection3pcd,ThirdPartyStoragePartitioning"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
